---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import { defaultLang, useTranslations } from '../i18n';

const lang = defaultLang;
const t = useTranslations(lang);
const homeHref = getRelativeLocaleUrl(lang, '/');
---

<Base lang={lang} title={`404 — ${t.meta.title}`}>
  <section class="not-found">
    <p class="code">404</p>
    <h1 class="text-h1 heading">{t.notFound.title}</h1>
    <p class="body">{t.notFound.body}</p>
    <a class="back" href={homeHref}>{t.notFound.back}</a>
  </section>
</Base>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding: 0 var(--page-gutter);
  }

  .code {
    margin: 0;
    color: var(--ink-faint);
    font-size: var(--fs-small);
    letter-spacing: 0.24em;
  }

  .heading {
    margin: 0.3em 0 0;
    font-family: var(--font-mincho);
    font-weight: 400;
  }

  .body {
    margin: 1.5em 0 0;
    color: var(--ink-muted);
  }

  .back {
    margin-top: 2.5rem;
    align-self: flex-start;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.3em;
    font-size: var(--fs-small);
    letter-spacing: 0.14em;
  }
</style>
