---
import type { GetStaticPaths } from 'astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../layouts/Base.astro';
import { locales, resolveLang, useTranslations } from '../../i18n';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = resolveLang(Astro.params.lang);
const t = useTranslations(lang);

const homeHref = getRelativeLocaleUrl(lang, '/');
const anchor = (id: string): string => `${homeHref}#${id}`;
---

<Base lang={lang}>
  <section id="hero" class="hero">
    <div class="shell">
      <p class="eyebrow">Portfolio</p>
      <h1 class="text-display name">{t.hero.name}</h1>
      <p class="role">{t.hero.role}</p>
      <p class="tagline">{t.hero.tagline}</p>
      <div class="cta">
        <a class="cta-link" href={anchor('projects')}>{t.hero.ctaProjects}</a>
        <a class="cta-link" href={anchor('contact')}>{t.hero.ctaContact}</a>
      </div>
      <span class="scroll">{t.hero.scroll}</span>
    </div>
  </section>

  <section id="projects" class="block">
    <div class="shell">
      <header class="section-head">
        <p class="eyebrow">01</p>
        <h2 class="text-h2 heading">{t.sections.projects}</h2>
      </header>
    </div>
  </section>

  <section id="about" class="block">
    <div class="shell">
      <header class="section-head">
        <p class="eyebrow">02</p>
        <h2 class="text-h2 heading">{t.sections.about}</h2>
      </header>
    </div>
  </section>

  <section id="experience" class="block">
    <div class="shell">
      <header class="section-head">
        <p class="eyebrow">03</p>
        <h2 class="text-h2 heading">{t.sections.experience}</h2>
      </header>
    </div>
  </section>

  <section id="skills" class="block">
    <div class="shell">
      <header class="section-head">
        <p class="eyebrow">04</p>
        <h2 class="text-h2 heading">{t.sections.skills}</h2>
      </header>
    </div>
  </section>

  <section id="contact" class="block">
    <div class="shell">
      <header class="section-head">
        <p class="eyebrow">05</p>
        <h2 class="text-h2 heading">{t.sections.contact}</h2>
      </header>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding: calc(var(--nav-height) + 2rem) var(--page-gutter) 4rem;
  }

  .name {
    margin: 0.2em 0 0;
    font-weight: 400;
  }

  .role {
    margin: 1.2em 0 0;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: var(--fs-small);
  }

  .tagline {
    margin: 1.6em 0 0;
    max-width: 52ch;
    color: var(--ink-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .cta-link {
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.6em 1.8em;
    font-size: var(--fs-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .cta-link:hover {
    background-color: var(--ink);
    color: var(--surface);
  }

  .scroll {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-top: 4rem;
    color: var(--ink-faint);
    font-size: var(--fs-small);
    line-height: 1.2;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .scroll::after {
    content: '';
    width: 1px;
    height: 3.5rem;
    background-color: var(--line-strong);
    transform: scaleY(0);
    transform-origin: top;
    animation: scroll-line 1.8s ease-in-out infinite;
  }

  /* 上から伸びて、下端へ吸い込まれる */
  @keyframes scroll-line {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }

    50% {
      transform: scaleY(1);
      transform-origin: top;
    }

    50.01% {
      transform: scaleY(1);
      transform-origin: bottom;
    }

    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  .eyebrow {
    margin: 0;
    color: var(--ink-faint);
    font-size: var(--fs-small);
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .block {
    border-top: 1px solid var(--line);
    padding-block: clamp(5rem, 20vh, 14rem);
    padding-inline: var(--page-gutter);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: clamp(1rem, 3vw, 2.5rem);
    margin-bottom: clamp(2.5rem, 7vh, 5rem);
  }

  .heading {
    margin: 0;
    font-family: var(--font-mincho);
    font-weight: 400;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll::after {
      animation: none;
      transform: scaleY(1);
    }
  }
</style>
