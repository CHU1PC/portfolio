<canvas id="geo-background" aria-hidden="true"></canvas>

<style>
  #geo-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  import { startGeoBackground } from '../scripts/geo-background';

  const canvas = document.getElementById('geo-background');
  if (canvas instanceof HTMLCanvasElement) {
    startGeoBackground(canvas);
  }
</script>
