{
  "name": "chu1pc.github.io",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:code": "biome check .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@astrojs/svelte": "^7.2.0",
    "astro": "^5.14.1",
    "svelte": "^5.39.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "^4.1.13",
    "lint-staged": "17.6.0",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,astro,svelte,css}": "biome check --write"
  }
}
